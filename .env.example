# ==============================================================================
# OLMERA HEALTHCARE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate your real API keys and credentials.
# Note: In Vite, variables exposed to the client must begin with 'VITE_'.

# ------------------------------------------------------------------------------
# 1. FIREBASE INFRASTRUCTURE (Required for Real Auth, Firestore & Storage)
# ------------------------------------------------------------------------------
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSy...your_actual_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. AI INTELLIGENCE LAYER - SERVER-SIDE ONLY (DO NOT PREFIX WITH VITE_)
# ------------------------------------------------------------------------------
# Secret provider keys MUST be stored without the VITE_ prefix so Vite never
# bundles them into client-side JavaScript. /api/llm reads these from process.env.
NVIDIA_API_KEY_AUTOGEN=nvapi-...your_first_nvidia_api_key
NVIDIA_MODEL_AUTOGEN=NVIDIABuild-Autogen-42

NVIDIA_API_KEY_MISTRAL=nvapi-...your_second_nvidia_api_key
NVIDIA_MODEL_MISTRAL=mistralai/mistral-large-4-1t-a52b

# Optional server-side fallbacks
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here

# ------------------------------------------------------------------------------
# 3. OCR & DOCUMENT EXTRACTION (Client-side OCR built-in; optional server key)
# ------------------------------------------------------------------------------
GOOGLE_VISION_API_KEY=your_google_cloud_vision_key_here

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Optional - For Telemedicine & In-Clinic Fee Collection)
# ------------------------------------------------------------------------------
# Razorpay Key ID: Obtain from https://dashboard.razorpay.com/
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
